{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Inflame21/engineering-governance/blob/main/22-governance-operations/model/governance-model.schema.json",
  "title": "Engineering Governance Model",
  "description": "Canonical machine-readable model for evaluating engineering changes against governance standards.",
  "type": "object",
  "required": [
    "version",
    "project",
    "change",
    "standards",
    "controls",
    "evidence",
    "risks",
    "decisions"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "change": {
      "$ref": "#/$defs/change"
    },
    "standards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/standard"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      },
      "default": []
    },
    "debt": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/debt"
      },
      "default": []
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "repository",
        "environment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "risk_class",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CHG-[0-9A-Z-]+$"
        },
        "type": {
          "enum": [
            "feature",
            "bugfix",
            "refactor",
            "security",
            "database",
            "infrastructure",
            "configuration",
            "release",
            "emergency"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "risk_class": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Declared changed-file set. When a Git diff is verified, this set must exactly match the actual changed paths."
        }
      },
      "additionalProperties": false
    },
    "standard": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,6}-\\d{3}$"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": [
        "id",
        "standard",
        "title",
        "severity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "standard": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "WARN",
            "NOT_APPLICABLE",
            "UNVERIFIED"
          ]
        },
        "applies_when": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_decision": {
          "enum": [
            "NO-GO",
            "GO_WITH_CONDITIONS",
            "REVIEW_REQUIRED",
            "NONE"
          ]
        },
        "message": {
          "type": "string"
        },
        "max_evidence_age_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status",
        "description",
        "source",
        "freshness",
        "supports_controls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EVD-[0-9A-Z-]+$"
        },
        "type": {
          "enum": [
            "E1_DIRECT_VERIFICATION",
            "E2_INSPECTION",
            "E3_AUTOMATED_ANALYSIS",
            "E4_OPERATIONAL",
            "E5_DOCUMENTARY",
            "E6_ASSERTION"
          ]
        },
        "status": {
          "enum": [
            "VERIFIED",
            "PARTIALLY_VERIFIED",
            "UNVERIFIED",
            "NOT_APPLICABLE"
          ]
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "freshness": {
          "type": "string",
          "minLength": 1
        },
        "supports_controls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "repository_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "exit_code": {
          "type": "integer"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freshness_status": {
          "enum": [
            "current",
            "stale",
            "expired",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "title",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RSK-[0-9A-Z-]+$"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "OPEN",
            "MITIGATED",
            "ACCEPTED",
            "CLOSED"
          ]
        },
        "mitigation": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "accepted_by": {
          "type": "string",
          "minLength": 1
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "acceptance_reason": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ACCEPTED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "accepted_by",
              "accepted_at",
              "acceptance_expires_at",
              "acceptance_reason"
            ],
            "properties": {
              "accepted_by": {
                "type": "string",
                "minLength": 1
              },
              "accepted_at": {
                "type": "string",
                "format": "date-time"
              },
              "acceptance_expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "acceptance_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DEC-[0-9A-Z-]+$"
        },
        "type": {
          "enum": [
            "READINESS",
            "REVIEW",
            "RELEASE",
            "PRODUCTION"
          ]
        },
        "status": {
          "enum": [
            "READY",
            "READY_WITH_CONDITIONS",
            "NOT_READY",
            "APPROVE",
            "APPROVE_WITH_CONDITIONS",
            "REQUEST_CHANGES",
            "REJECT",
            "GO",
            "GO_WITH_CONDITIONS",
            "NO-GO"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EXC-[0-9A-Z-]+$"
        },
        "status": {
          "enum": [
            "REQUESTED",
            "APPROVED",
            "REJECTED",
            "EXPIRED",
            "CLOSED"
          ]
        },
        "control": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "change_id": {
          "type": "string",
          "pattern": "^CHG-[0-9A-Z-]+$"
        },
        "requested_by": {
          "type": "string",
          "minLength": 1
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "REQUESTED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "control",
              "reason",
              "project_id",
              "change_id",
              "requested_by",
              "requested_at"
            ],
            "properties": {
              "control": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "change_id": {
                "type": "string",
                "pattern": "^CHG-[0-9A-Z-]+$"
              },
              "requested_by": {
                "type": "string",
                "minLength": 1
              },
              "requested_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "control",
              "reason",
              "project_id",
              "change_id",
              "requested_by",
              "requested_at",
              "approved_by",
              "approved_at",
              "expires_at"
            ],
            "properties": {
              "control": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "change_id": {
                "type": "string",
                "pattern": "^CHG-[0-9A-Z-]+$"
              },
              "requested_by": {
                "type": "string",
                "minLength": 1
              },
              "requested_at": {
                "type": "string",
                "format": "date-time"
              },
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "debt": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DEBT-[0-9A-Z-]+$"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "status": {
          "enum": [
            "OPEN",
            "PLANNED",
            "IN_PROGRESS",
            "ACCEPTED",
            "RESOLVED"
          ]
        },
        "title": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule_id",
        "severity",
        "category",
        "message",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "OPEN",
            "ACKNOWLEDGED",
            "IN_PROGRESS",
            "RESOLVED",
            "ACCEPTED",
            "SUPPRESSED",
            "UNVERIFIED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            },
            "start_column": {
              "type": "integer",
              "minimum": 1
            },
            "end_column": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
